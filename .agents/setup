#!/usr/bin/env bash
set -euo pipefail
packages=(pkg-config libpng-dev libcairo2-dev libx264-dev nasm libva-dev libgbm-dev libdrm-dev sway swaybg grim ffmpeg python3-pil libsystemd-dev python3-dbus python3-gi ninja-build libxkbcommon-dev libinput-dev libseat-dev libudev-dev libjson-c-dev libpcre2-dev libpango1.0-dev libevdev-dev libffi-dev libexpat1-dev libmtdev-dev)
missing=()
for package in "${packages[@]}"; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || missing+=("$package")
done
if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo apt-get install -y "${missing[@]}"
fi
python3 -m pip install 'meson>=1.3,<2' 'Pillow>=10,<13'
bash .agents/setup-wayland
if ! command -v zig >/dev/null || [[ $(zig version) != 0.16.0 ]]; then
    archive=$(mktemp)
    trap 'rm -f "$archive"' EXIT
    curl -fsSL https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz -o "$archive"
    echo "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00  $archive" | sha256sum -c -
    sudo tar -xJf "$archive" -C /opt
    sudo ln -sf /opt/zig-x86_64-linux-0.16.0/zig /usr/local/bin/zig
fi
# Debian 12's FFmpeg 5 lacks APIs used by the existing recording bridge.
if [[ ! -f /opt/ouroshot-ffmpeg/lib/pkgconfig/libavcodec.pc ]]; then
    scratch=$(mktemp -d)
    curl -fsSL https://ffmpeg.org/releases/ffmpeg-7.1.2.tar.xz -o "$scratch/ffmpeg.tar.xz"
    echo "089bc60fb59d6aecc5d994ff530fd0dcb3ee39aa55867849a2bbc4e555f9c304  $scratch/ffmpeg.tar.xz" | sha256sum -c -
    tar -xf "$scratch/ffmpeg.tar.xz" -C "$scratch"
    (cd "$scratch/ffmpeg-7.1.2" && ./configure --prefix=/opt/ouroshot-ffmpeg --enable-shared --disable-static --disable-doc --disable-debug --disable-programs --disable-network --enable-gpl --enable-libx264 && make -j8 && sudo make install)
    rm -rf "$scratch"
fi
export PKG_CONFIG_PATH="/opt/ouroshot-ffmpeg/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
if ! grep -Fq '# ouroshot FFmpeg' "$HOME/.bash_profile"; then
    printf '\n# ouroshot FFmpeg\nexport PKG_CONFIG_PATH=/opt/ouroshot-ffmpeg/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}\n' >> "$HOME/.bash_profile"
fi
echo /opt/ouroshot-ffmpeg/lib | sudo tee /etc/ld.so.conf.d/ouroshot-ffmpeg.conf >/dev/null
sudo ldconfig
# Zig's resolver rejects the orb's newline-less resolv.conf. curl/git honor it;
# fetch these exact pinned contents into Zig's verified package cache instead.
if ! zig build --fetch; then
    scratch=$(mktemp -d)
    curl -fsSL https://github.com/rockorager/wayring/archive/f25839e4c4700c42fbb4cb3f8951b653829cf1d2.tar.gz -o "$scratch/wayring.tar.gz"
    zig fetch "$scratch/wayring.tar.gz"
    curl -fsSL https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.26.0/downloads/wayland-1.26.0.tar.xz -o "$scratch/wayland.tar.xz"
    zig fetch "$scratch/wayland.tar.xz"
    curl -fsSL https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.49/downloads/wayland-protocols-1.49.tar.xz -o "$scratch/protocols.tar.xz"
    zig fetch "$scratch/protocols.tar.xz"
    git clone -q https://gitlab.freedesktop.org/wlroots/wlr-protocols.git "$scratch/wlr"
    git -C "$scratch/wlr" archive --format=tar bf4fc79abc359eea5a0edec0ac6d4a2b2955f82a -o "$scratch/wlr.tar"
    zig fetch "$scratch/wlr.tar"
    rm -rf "$scratch"
fi
zig build
zig build test
