# Ouro-specific capture API, implemented by ouroshot-service.
# Transport, authorization and artifact lifetime requirements are in README.md.
interface dev.rockorager.ouro.Capture

# Identity is attribution, not a bearer credential. A native service must obtain
# transport credentials and require its own user confirmation for every call.
type Context (
    app_id: string,
    parent_window: string,
    origin: string,
    require_confirmation: bool,
    permission_store_checked: bool
)

# Return a completed, private PNG through an absolute percent-encoded file URI.
# interactive is a customization hint, not a rectangle-selection instruction.
method Screenshot(context: Context, modal: bool, interactive: bool) -> (uri: string)

# The array must have exactly three finite sRGB components in [0, 1].
method PickColor(context: Context, modal: bool, interactive: bool) -> (color: []float)

# The user explicitly dismissed the native interaction.
error Cancelled()
# Native policy refused the operation.
error Denied()
# The native service cannot currently accept another interaction.
error Busy()
# Capture, rendering, encoding or persistence failed.
error Failed()
